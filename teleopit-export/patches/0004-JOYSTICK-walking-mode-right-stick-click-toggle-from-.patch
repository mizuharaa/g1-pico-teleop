 4 files changed, 122 insertions(+)

diff --git a/teleopit/configs/pico4_sim2real.yaml b/teleopit/configs/pico4_sim2real.yaml
index 2417fa8..70e364f 100644
--- a/teleopit/configs/pico4_sim2real.yaml
+++ b/teleopit/configs/pico4_sim2real.yaml
@@ -167,3 +167,11 @@ mocap_switch:
 hydra:
   run:
     dir: .
+
+# Joystick walking mode (2026-08-17): press RIGHT STICK CLICK to toggle from
+# STANDING. Left stick = walk/strafe, right stick X = turn. X exits to STANDING.
+joystick:
+  vx_max: 0.5      # m/s forward/back cap
+  vy_max: 0.3      # m/s strafe cap
+  wz_max: 0.8      # rad/s turn cap
+  stick_deadzone: 0.12
